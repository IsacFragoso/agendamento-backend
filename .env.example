NODE_ENV=development
PORT=8000

# Database (use DATABASE_URL or the individual DB_* settings; Neon requires SSL)
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=agendamento
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRATION=3600

# Cloudinary (optional - add your credentials to use image storage)
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# SMTP password recovery (optional; required to enable password reset)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
FRONTEND_URL=https://isacfragoso.github.io/agendamento-frontend/
